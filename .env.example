# -----------------------------------------------------------------------
# Anthropic — the LLM provider for all text agents (via src/llm_client.py)
# -----------------------------------------------------------------------
# Required.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model tiers (optional — sensible defaults are used if unset).
#   heavy    — complex generation (writer, qa, article diagnostic)
#   standard — balanced tasks     (brief, serp, seo, company, readability, faq)
#   light    — cheap/fast tasks   (metadata copy)
# ANTHROPIC_MODEL_HEAVY=claude-opus-5
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-5
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5

# How hard the models think. One of: low, medium, high, xhigh, max.
# Unset runs each model at its own default. Thinking is billed as output and
# shares the token budget with the answer, so raising this raises both cost
# and the budget each agent needs.
# ANTHROPIC_EFFORT=high

# Output budget per call (ceiling, not a spend — you pay for what is used).
# Must hold the thinking as well as the answer.
# ANTHROPIC_MAX_TOKENS=16000
#
# Per-request timeout in seconds and the retry ceiling. Left unset the client
# runs on the SDK defaults, where a wedged request is never abandoned — one
# held a nine-step pipeline for 47 minutes with no output.
# ANTHROPIC_TIMEOUT=300
# ANTHROPIC_MAX_RETRIES=2
# WRITER_MAX_TOKENS=32000

# Only used when ANTHROPIC_API_KEY is absent and the app runs inside a Claude
# Code session, where agents fall back to the Claude Agent SDK.
# ANTHROPIC_MODEL=claude-opus-5

# -----------------------------------------------------------------------
# SERP / Competitor Research Agent — provider configuration
# -----------------------------------------------------------------------
# SERP_PROVIDER controls which SERP backend the SERP Research Agent uses.
#
# mock    (default) — no live internet required; agent generates a
#                     clearly-labeled category-pattern stub.
# serpapi            — live Google results via SerpAPI (serpapi.com).
#                     Requires SERPAPI_KEY to be set.
#
# Default is mock so the agent runs out of the box without any API keys.
# -----------------------------------------------------------------------
SERP_PROVIDER=mock

# Required only when SERP_PROVIDER=serpapi
# SERPAPI_KEY=your-serpapi-key-here

# Set to true to fetch and include page body text in live SERP mode.
# Increases analysis quality but also API/network usage.
# SERP_FETCH_PAGES=false

# -----------------------------------------------------------------------
# Visual Agent — DALL-E 3 image generation
# -----------------------------------------------------------------------
# Image generation is the one thing still on OpenAI — Anthropic has no image
# model. Set OPENAI_API_KEY for real images. If it is absent, the
# Visual Agent runs in mock mode: images are skipped and
# <!-- IMAGE PLACEHOLDER --> comments are inserted into the draft instead.
# -----------------------------------------------------------------------
