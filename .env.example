# -----------------------------------------------------------------------
# OpenAI — primary LLM provider for all text agents (via src/llm_client.py)
# -----------------------------------------------------------------------
# Required. Also powers DALL-E 3 image generation in the Visual Agent.
OPENAI_API_KEY=your-openai-api-key-here

# Model tiers (optional — sensible gpt-5 defaults are used if unset).
#   heavy    — complex generation (writer, qa, article diagnostic)
#   standard — balanced tasks     (brief, serp, seo, company, readability, faq)
#   light    — cheap/fast tasks    (visual, metadata copy)
# OPENAI_MODEL_HEAVY=gpt-5
# OPENAI_MODEL_STANDARD=gpt-5-mini
# OPENAI_MODEL_LIGHT=gpt-5-nano

# -----------------------------------------------------------------------
# Anthropic — OPTIONAL fallback only
# -----------------------------------------------------------------------
# Used solely by the Claude Agent SDK fallback path (when OPENAI_API_KEY
# is absent and the app runs inside a Claude Code session). Not needed in
# normal OpenAI-backed deployments.
# ANTHROPIC_MODEL=claude-opus-4-6

# -----------------------------------------------------------------------
# SERP / Competitor Research Agent — provider configuration
# -----------------------------------------------------------------------
# SERP_PROVIDER controls which SERP backend the SERP Research Agent uses.
#
# mock    (default) — no live internet required; agent generates a
#                     clearly-labeled category-pattern stub.
# serpapi            — live Google results via SerpAPI (serpapi.com).
#                     Requires SERPAPI_KEY to be set.
#
# Default is mock so the agent runs out of the box without any API keys.
# -----------------------------------------------------------------------
SERP_PROVIDER=mock

# Required only when SERP_PROVIDER=serpapi
# SERPAPI_KEY=your-serpapi-key-here

# Set to true to fetch and include page body text in live SERP mode.
# Increases analysis quality but also API/network usage.
# SERP_FETCH_PAGES=false

# -----------------------------------------------------------------------
# Visual Agent — DALL-E 3 image generation
# -----------------------------------------------------------------------
# Uses the same OPENAI_API_KEY set above. If that key is absent, the
# Visual Agent runs in mock mode: images are skipped and
# <!-- IMAGE PLACEHOLDER --> comments are inserted into the draft instead.
# -----------------------------------------------------------------------
