{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fact Research Agent output",
  "type": "object",
  "required": ["topic", "findings", "unanswered"],
  "properties": {
    "topic": { "type": "string" },
    "findings": {
      "type": "array",
      "description": "One entry per research question that produced usable figures.",
      "items": {
        "type": "object",
        "required": ["question", "range", "sources", "confidence"],
        "properties": {
          "question": {
            "type": "string",
            "description": "The research question, not the article keyword."
          },
          "range": {
            "type": "object",
            "required": ["low", "typical", "high", "unit"],
            "properties": {
              "low": { "type": ["number", "string"] },
              "typical": { "type": ["number", "string"] },
              "high": { "type": ["number", "string"] },
              "unit": { "type": "string", "description": "e.g. 'USD per week per machine'" }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "description": "A figure with no source may not be reported.",
            "items": {
              "type": "object",
              "required": ["url", "figure", "kind"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "figure": {
                  "type": "string",
                  "description": "What this source actually said, quoted or closely paraphrased."
                },
                "kind": {
                  "type": "string",
                  "enum": ["industry", "operator", "forum", "vendor", "own_site", "press", "unknown"],
                  "description": "vendor and own_site sell the product; they may set an upper bound, never the typical case."
                },
                "date": { "type": "string" }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "caveats": { "type": "string" }
        }
      }
    },
    "unanswered": {
      "type": "array",
      "description": "Questions searched but not answered. Not a failure — the article must say so rather than invent.",
      "items": { "type": "string" }
    },
    "notes_for_writer": { "type": "array", "items": { "type": "string" } },
    "searches_performed": { "type": "integer" }
  }
}
