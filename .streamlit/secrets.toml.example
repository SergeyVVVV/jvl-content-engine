# Copy this file to .streamlit/secrets.toml and fill in real values.
# On Streamlit Cloud, paste the same content into: App settings → Secrets.

# Publishing drafts to jvl.ca (the "Publish draft to JVL" panel).
# JVL_PUBLISH_TOKEN must equal CONTENT_PUBLISH_TOKEN in the Next.js app's
# .env.local on the server. Without both keys the panel stays disabled.
# These are read as top-level secrets, not inside a section.
JVL_PUBLISH_URL = "https://www.jvl.ca"
JVL_PUBLISH_TOKEN = "..."

[supabase]
url = "https://xxxxx.supabase.co"       # Project URL
service_key = "sb_secret_..."           # Secret key (server-side only, never expose)
